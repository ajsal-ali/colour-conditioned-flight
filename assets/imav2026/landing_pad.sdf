<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="landing_pad">

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <atmosphere type="adiabatic" />
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />

    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <light name="hall_sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0.0 0.0 22.0 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Floor -->
    <model name="arena_floor">
      <static>true</static><pose>0.0 0.0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>15.4 30.8 0.044</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>15.4 30.8 0.044</size></box></geometry>
          <material>
            <ambient>0.80 0.06 0.06 1</ambient>
            <diffuse>0.80 0.06 0.06 1</diffuse>
            <pbr><metal><roughness>0.8</roughness><metalness>0.0</metalness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Landing Platform -->
    <model name="landing_platform">
      <static>false</static>

      <link name="carriage">
        <pose>0.0 0.0 0.22 0 0 0</pose> <!-- Brought to center -->
        <inertial>
          <mass>4.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
      </link>

      <joint name="stroke_joint" type="prismatic">
        <parent>world</parent>
        <child>carriage</child>
        <axis>
          <xyz>0 1 0</xyz> <!-- Moving in Y direction -->
          <limit>
            <lower>-12.0</lower>
            <upper>12.0</upper>
          </limit>
          <dynamics>
            <spring_reference>4.0</spring_reference> <!-- Increased to create wider oscillation -->
            <spring_stiffness>5.0</spring_stiffness> <!-- Adjusted to make it smooth over the large distance -->
            <damping>0.0</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>

      <link name="base_link">
        <pose>0.0 0.0 0.22 0.2618 0 0</pose> <!-- Brought to center, tilted properly -->
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>

        <collision name="col">
          <geometry><box><size>1.1 1.1 0.11</size></box></geometry> <!-- Same dimensions -->
        </collision>

        <visual name="vis_base">
          <geometry><box><size>1.1 1.1 0.11</size></box></geometry>
          <material><ambient>0.12 0.60 0.12 1</ambient><diffuse>0.12 0.60 0.12 1</diffuse></material>
        </visual>

        <collision name="aruco_id1_col">
          <pose>0.0 0.0 0.0572 0 0 -1.5708</pose> <!-- ArUco marker location -->
          <geometry><box><size>0.88 0.88 0.0022</size></box></geometry>
        </collision>
        <visual name="aruco_id1">
          <pose>0.0 0.0 0.0572 0 0 -1.5708</pose>
          <geometry><box><size>0.88 0.88 0.0022</size></box></geometry>
          <material>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://materials/textures/aruco_marker_1.jpg</albedo_map> <!-- ArUco marker ID 1 texture map -->
                <roughness>0.5</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>

      <joint name="pitch_joint" type="revolute">
        <parent>carriage</parent>
        <child>base_link</child>
        <axis>
          <xyz>1 0 0</xyz> <!-- Pitch axis -->
          <limit>
            <lower>-1.151</lower>
            <upper>0.0</upper>
          </limit>
          <dynamics>
            <spring_reference>-0.2618</spring_reference> <!-- Same dynamics as imav2026_scaled.sdf -->
            <spring_stiffness>0.125</spring_stiffness>
            <damping>0.0</damping>
            <friction>0.0</friction>
          </dynamics>
        </axis>
      </joint>
    </model>

  </world>
</sdf>
